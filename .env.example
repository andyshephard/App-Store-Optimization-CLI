# Storefronts the CLI and dashboard are allowed to query (comma-separated).
# Unset means US only, which is upstream's behaviour. Each entry must exist in
# cli/shared/aso-storefronts.ts; unknown codes are ignored by the dashboard and
# rejected by the CLI.
# ASO_SUPPORTED_COUNTRIES=US,GB,CA,AU,IE,NZ,DE,FR,ES,IT,PT

# Shared secret required on every dashboard/API request. When unset the server
# is unauthenticated and will only bind to loopback - it refuses to start on any
# other host without this. Minimum 32 characters; generate with:
#   openssl rand -hex 32
# ASO_API_TOKEN=

# Origin permitted to make state-changing requests from a browser. Set this to
# the public dashboard URL when running behind a reverse proxy.
# ASO_ALLOWED_ORIGIN=https://aso.example.com

# Open a browser at startup. Defaults to on only when bound to loopback, so a
# container never tries. Set 0 to force off, 1 to force on.
# ASO_OPEN_BROWSER=0

# Skip the npm registry version check at startup (one less outbound call).
# ASO_DISABLE_UPDATE_CHECK=1

# Never use the OS credential store, even on macOS.
# ASO_DISABLE_CREDENTIAL_STORE=1

# Optional ASO runtime settings
# ASO_DB_PATH=/absolute/path/to/aso-db.sqlite
# ASO_PRIMARY_APP_ID=1234567890
#   Pre-seeds the primary App ID, which otherwise lives in the SQLite metadata
#   table and would leave a fresh deployment waiting on the setup prompt.
# ASO_AUTH_MODE=auto
# ASO_APPLE_WIDGET_KEY=
# ASO_SIRP_RUBY_ORACLE=0
# ASO_SIRP_USE_RUBY_PROOF=0

# Optional ASO resilience tuning
# ASO_RETRY_MAX_ATTEMPTS=4
# ASO_RETRY_BASE_DELAY_MS=1000
# ASO_RETRY_MAX_DELAY_MS=30000
# ASO_RATE_LIMIT_BASE_DELAY_MS=5000
# ASO_RETRY_JITTER_FACTOR=0.1
# ASO_KEYWORD_ENRICHMENT_CONCURRENCY=4
#
# Pacing for the background refresh. Apple throttles the app-detail endpoint per
# storefront and answers 403 once a burst is too large, and 403 is not treated
# as transient - so a throttled storefront fails the rest of its keywords fast.
# ASO_REFRESH_INTER_COUNTRY_DELAY_MS=180000
# ASO_REFRESH_INTER_BATCH_DELAY_MS=5000
# ASO_KEYWORD_ORDER_TTL_HOURS=24
# ASO_POPULARITY_CACHE_TTL_HOURS=720
# ASO_APP_CACHE_TTL_HOURS=168
# ASO_OWNED_APP_DOC_REFRESH_MAX_AGE_HOURS=24

# Optional dashboard server bind (advanced; defaults preserve 127.0.0.1:3456)
# Set ASO_DASHBOARD_HOST=0.0.0.0 (or ::) to expose the dashboard on the network.
# WARNING: Non-loopback binding exposes the dashboard and its API without
# authentication. Use it only on a trusted private network or behind an
# authenticated reverse proxy. Do not publish the dashboard port directly.
# ASO_DASHBOARD_HOST=127.0.0.1
# ASO_DASHBOARD_PORT=3456

# Optional PostHog runtime telemetry
# ASO_POSTHOG_API_KEY=phc_xxx
# ASO_POSTHOG_HOST=https://us.i.posthog.com
